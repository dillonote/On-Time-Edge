# LLM provider: "template" (no LLM), "ollama", "compatible", or "anthropic"
PROVIDER=template
MODEL=claude-sonnet-4-5-20250929
TEMP=0.6

# Anthropic / Claude (when PROVIDER=anthropic)
ANTHROPIC_API_KEY=

# Ollama (when PROVIDER=ollama)
OLLAMA_URL=http://localhost:11434/api/chat

# OpenAI-compatible provider (when PROVIDER=compatible)
COMPAT_BASE_URL=
COMPAT_API_KEY=

# Optional: path to a JSON file overriding default brand settings
BRAND_PROFILE_JSON=
