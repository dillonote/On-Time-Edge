# LLM provider: "template" (no LLM), "ollama", or "compatible"
PROVIDER=template
MODEL=llama3.1
TEMP=0.6

# Ollama (when PROVIDER=ollama)
OLLAMA_URL=http://localhost:11434/api/chat

# OpenAI-compatible provider (when PROVIDER=compatible)
COMPAT_BASE_URL=
COMPAT_API_KEY=

# Optional: path to a JSON file overriding default brand settings
BRAND_PROFILE_JSON=
