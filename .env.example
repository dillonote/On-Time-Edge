# =============================================================================
# OTE Marketing Copy Generator v2.0 — Environment Configuration
# =============================================================================
# Copy to .env and fill in your values.

# Provider: template | ollama | compatible
PROVIDER=template

# Model name (for ollama/compatible providers)
MODEL=llama3.1

# Temperature (0.0 - 1.0)
TEMP=0.6

# Ollama endpoint (when PROVIDER=ollama)
OLLAMA_URL=http://localhost:11434/api/chat

# OpenAI-compatible API (when PROVIDER=compatible)
# Works with Anthropic, OpenRouter, Together, etc.
COMPAT_BASE_URL=
COMPAT_API_KEY=

# Optional: path to custom brand profile JSON
BRAND_PROFILE_JSON=
